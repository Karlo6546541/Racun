# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://ailingo:ailingo@localhost:5432/ailingo"
# Direct connection used by migrations (same as DATABASE_URL locally; non-pooled URL in production)
DIRECT_URL="postgresql://ailingo:ailingo@localhost:5432/ailingo"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic link. Leave SMTP empty in development: the link is printed to the server console.
EMAIL_SERVER=""
EMAIL_FROM="AIlingo <noreply@example.com>"
# Comma-separated emails that get the ADMIN role on sign-in
ADMIN_EMAILS=""

# --- Secrets for this app ---
# Used to shuffle answer options per session (anti-cheat). openssl rand -hex 32
SESSION_HMAC_SECRET=""
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# --- Monetization ---
FREE_DAILY_MINUTES="10"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
STRIPE_TRIAL_DAYS="7"
# "on" enables Stripe Tax (automatic VAT)
STRIPE_TAX="off"

# --- Web Push reminders (optional). npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Feature flags ---
# Optional AI grader stub. Must stay OFF: the app never calls any AI service.
FEATURE_AI_GRADER="off"

# --- Testing only (never set in production) ---
E2E=""
E2E_TEST_SECRET=""
